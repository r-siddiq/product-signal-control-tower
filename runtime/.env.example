# Copy this file to runtime/.env, then replace every __GENERATE_LOCAL_*__
# marker with a fresh machine-local value. Never commit runtime/.env.
#
# Generate each database password with a password manager or a cryptographically
# secure generator. Generate N8N_ENCRYPTION_KEY as at least 32 random bytes
# (for example: openssl rand -base64 48). Keep the encryption key stable for the
# lifetime of the n8n data volume, or stored credentials will become unreadable.

POSTGRES_PASSWORD=CHANGE_ME
N8N_DB_PASSWORD=CHANGE_ME
DEMO_DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
