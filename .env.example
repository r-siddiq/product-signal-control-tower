# Reference only; this file is not loaded automatically.
# API tools use process environment or runtime/.n8n-api.env.
N8N_API_URL=CHANGE_ME
N8N_API_KEY=CHANGE_ME
# Browser checks read the owner variables from runtime/.owner.env.
N8N_OWNER_EMAIL=CHANGE_ME
N8N_OWNER_PASSWORD=CHANGE_ME

# Optional: omit this variable to use Playwright's bundled Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=CHANGE_ME
